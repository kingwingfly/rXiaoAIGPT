# Xiaomi account credentials, used by both crates to log in.
ACCOUNT_ID=
ACCOUNT_PASSWORD=

# Optional: a fixed 16-character device id. One is generated per process if
# unset, which makes Xiaomi ask for identity verification more often.
# DEVICE_ID=

# Logging. Defaults to `warn,xiaoai_llm=info,xiaoai=info`. Use
# `RUST_LOG=xiaoai=debug` to trace the raw (undocumented) Xiaomi login exchanges.
# RUST_LOG=

# --- xiaoai_llm agent only ---

# Speaker alias as shown in the Mi Home app. The account must own the device.
XIAOAI_DEVICE=
# Address the speaker uses to reach this host — a LAN address, not loopback.
XIAOAI_HOST_IP=
# XIAOAI_PORT=3000
# XIAOAI_MUSIC_DIR=.
# XIAOAI_AUTH_CACHE=auth_data.json

# Base URL handed to the speaker, if it is not `http://$XIAOAI_HOST_IP:$XIAOAI_PORT`.
# The server always binds 0.0.0.0:$XIAOAI_PORT; this is only what the speaker is
# told to fetch, so set it when we are published through a proxy or tunnel
# (e.g. Cloudflare) rather than reached directly over the LAN.
# XIAOAI_PUBLIC_BASE_URL=https://music.example.com

# Shared secret prefixing the audio URLs. The speaker cannot authenticate, so
# behind Cloudflare Access the audio path needs a Bypass policy; this token is
# what the origin checks instead. Unset means no check — LAN-only deployments.
# XIAOAI_STREAM_TOKEN=

# DeepSeek, for the LLM intent layer. Optional at this stage; nothing reads it yet.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Where the NetEase Cloud Music login session (cookies) is cached.
# NETEASE_SESSION=netease_session.json
