# Every variable the code actually reads. Commented-out lines show the default.
# Copy to `.env`; `xiaoai_llm` loads it at startup, as do the `xiaoai` tests.

# --- Xiaomi account (read by the `xiaoai` crate, account.rs) ---

# REQUIRED for the first login. Afterwards the cached auth data is enough,
# until it expires or XIAOAI_AUTH_CACHE is deleted.
ACCOUNT_ID=
ACCOUNT_PASSWORD=

# Optional: a fixed device id, which must be exactly 16 characters (it is
# uppercased, and a wrong length panics). One is generated per process if unset,
# which makes Xiaomi demand identity verification far more often.
# DEVICE_ID=

# --- Logging (read by tracing-subscriber's EnvFilter, in main.rs) ---

# Optional. `RUST_LOG=xiaoai=debug` traces the raw, undocumented Xiaomi login
# exchanges. There is no XIAOAI_DEBUG.
# RUST_LOG=warn,xiaoai_llm=info,xiaoai=info

# --- The agent (read by rXiaoaiLLM/src/config.rs) ---

# REQUIRED. Speaker alias as shown in the Mi Home app. The account must *own*
# the device; being an administrator of it is not enough.
XIAOAI_DEVICE=
# REQUIRED. Address the speaker uses to reach this host — a LAN address, never
# loopback: the speaker downloads the audio itself. Only used to build the
# default of XIAOAI_PUBLIC_BASE_URL below.
XIAOAI_HOST_IP=

# Optional. Port the HTTP server binds; it always binds 0.0.0.0 on this port.
# XIAOAI_PORT=3000
# Optional. Directory scanned for audio and served over HTTP.
# XIAOAI_MUSIC_DIR=.
# Optional. Where the Xiaomi login result is cached; delete it to re-login.
# XIAOAI_AUTH_CACHE=auth_data.json

# Optional. Base URL handed to the speaker, defaulting to
# `http://$XIAOAI_HOST_IP:$XIAOAI_PORT`. This is *not* the bind address — set it
# when the speaker reaches us through a proxy or tunnel (Cloudflare and friends)
# instead of directly over the LAN. A trailing slash is stripped.
# XIAOAI_PUBLIC_BASE_URL=https://music.example.com

# Optional. Unguessable secret prefixing the audio URLs. The speaker cannot send
# Access headers, so a Cloudflare deployment must put the audio path on a Bypass
# policy and let the origin check this token instead. Unset means no check.
# NOTE: config.rs reads it, but nothing enforces it yet — see rXiaoaiLLM/README.md.
# XIAOAI_STREAM_TOKEN=

# Optional. DeepSeek, for the LLM intent layer. deepseek-chat and
# deepseek-reasoner were retired on 2026-07-24; do not use them.
# Read into Config today, but not yet consumed by anything.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Where the NetEase Cloud Music login session (its two cookies) is
# cached. Read into Config today, but not yet consumed by anything.
# NETEASE_SESSION=netease_session.json
